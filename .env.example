# AKILI — example environment file
#
# Copy to `.env` and fill in real values locally. `.env` is git-ignored.
# This file contains PLACEHOLDERS ONLY. Never commit real credentials.
#
# Security rule (architecture principle #10):
# Values marked SECRET are loaded by the backend only. They must never be
# placed into an LLM prompt, tool argument, log line, or model context.
#
# Variable names below cover only what Phase 1 has committed to. Additional
# variables (Binance Agent OS / MCP endpoints, voice, auth) will be added in
# later phases against official documentation — they are not guessed here.

# ---------------------------------------------------------------------------
# Application  (the only section the backend reads today)
# ---------------------------------------------------------------------------
APP_NAME=AKILI
APP_ENV=development
DEBUG=true
# BACKEND_HOST is the declared listen address. The development identity mode
# below refuses to start unless it is a loopback address. Start uvicorn with
# the same value: `uvicorn app.main:app --host 127.0.0.1`.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ---------------------------------------------------------------------------
# Identity — DEVELOPMENT ONLY. This is not authentication.
#
# AUTH_MODE=disabled (the default when unset): every route that needs a user
#   answers 401. Nothing user-owned is reachable. Safe for any environment.
# AUTH_MODE=development_fixed_user: every request is served as the single user
#   DEV_FIXED_USER_ID. Only constructible with APP_ENV=development and a
#   loopback BACKEND_HOST; the process refuses to start otherwise. Seed the
#   user once with:  cd backend && python -m app.auth.seed
#
# Real authentication (sessions, login) is a later phase and will be a new
# AUTH_MODE; nothing else about identity changes when it arrives.
# ---------------------------------------------------------------------------
AUTH_MODE=disabled
DEV_FIXED_USER_ID=              # any UUID you choose once, e.g. from `uuidgen`

# ---------------------------------------------------------------------------
# PostgreSQL
# Used both by the backend and by docker-compose.yml for local development.
# Host port is 5433, not 5432, so AKILI does not collide with any PostgreSQL
# you may already run on this machine.
# ---------------------------------------------------------------------------
POSTGRES_USER=akili
POSTGRES_PASSWORD=          # SECRET — set a local value, do not commit
POSTGRES_DB=akili
POSTGRES_PORT=5433

# SQLAlchemy async URL used by the backend and by Alembic.
# The +asyncpg driver is required — the backend uses async database access.
# Fill in the same password you set above:
#   postgresql+asyncpg://akili:<password>@127.0.0.1:5433/akili
DATABASE_URL=

# Dedicated database for the test suite, so tests never touch development data.
# Create it once with:  createdb -h 127.0.0.1 -p 5433 -U akili akili_test
#   postgresql+asyncpg://akili:<password>@127.0.0.1:5433/akili_test
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Runtime LLM provider
# Read by the backend only. The frontend never receives these. The key goes to
# the provider SDK client and is never placed in a prompt or model context.
# ---------------------------------------------------------------------------
# Supported providers: anthropic
LLM_PROVIDER=anthropic
# Model ID as documented by the provider, e.g. claude-opus-5. Not defaulted in
# code, so nothing obsolete is baked into the repository.
LLM_MODEL=
LLM_API_KEY=                # SECRET
# Optional tuning (defaults shown)
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_OUTPUT_TOKENS=4096
# AGENT_HISTORY_MESSAGES=10

# ---------------------------------------------------------------------------
# Direct Binance Spot REST API credentials (server-side only)
#
# Use a Binance Spot sub-account API key with read-only permissions. These
# values are never sent to the frontend. Set BINANCE_USE_TESTNET=true only when
# the key belongs to Binance Spot Testnet.
# ---------------------------------------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=       # SECRET
BINANCE_USE_TESTNET=false

# ---------------------------------------------------------------------------
# Binance Agentic MCP — AKILI's OWN OAuth client (Phase 6)
#
# AKILI reaches Binance through the Binance Agentic MCP server, authorizing as
# an independent public OAuth client identified by a Client ID Metadata
# Document (CIMD) that AKILI itself serves. There is no API key or client
# secret: nothing below is a Binance credential. AKILI never uses another
# application's Binance authorization.
#
# BINANCE_OAUTH_ENABLED=false (default): the CIMD document and the connect
#   route both answer 404. Nothing is published.
# BINANCE_OAUTH_ENABLED=true: all four values below are required and checked at
#   startup. BINANCE_CIMD_URL is AKILI's client_id; it must be an https URL
#   ending in exactly /.well-known/akili-mcp-client.json, and Binance must be
#   able to fetch it — for local development that means a stable public HTTPS
#   tunnel to this backend. The redirect URI must be https, or http on
#   127.0.0.1 for development, and is what the CIMD document declares.
# ---------------------------------------------------------------------------
BINANCE_OAUTH_ENABLED=false
BINANCE_MCP_SERVER_URL=https://agent.binance.com/mcp/agentic
BINANCE_CIMD_URL=           # https://<your-akili-host>/.well-known/akili-mcp-client.json
BINANCE_REDIRECT_URI=       # https://<your-akili-host>/api/v1/binance/oauth/callback
# SECRET. Seals per-request OAuth secrets at rest (PKCE verifier now, tokens
# later). Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=

# Binance Sub-Account Credentials
BINANCE_API_KEY="YOUR_SUBACCOUNT_API_KEY"
BINANCE_API_SECRET="YOUR_SUBACCOUNT_SECRET_KEY"

# Environment Mode
BINANCE_USE_TESTNET=false
