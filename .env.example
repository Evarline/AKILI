# AKILI environment template
#
# Copy this file to `.env` and replace placeholders with local values.
# `.env` is git-ignored. Never commit credentials.

# Backend application
APP_ENV=development
DEBUG=true
BACKEND_HOST=127.0.0.1

# Development identity only. This is not authentication.
# Keep AUTH_MODE=disabled unless you need to use protected routes locally.
# For fixed-user mode, choose one UUID and seed it with:
#   cd backend && python -m app.auth.seed
AUTH_MODE=disabled
DEV_FIXED_USER_ID=

# PostgreSQL
# Docker Compose uses POSTGRES_*; the backend and Alembic use DATABASE_URL.
# The local Compose port is 5433.
POSTGRES_USER=akili
POSTGRES_PASSWORD=
POSTGRES_DB=akili
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://akili:<url-encoded-password>@127.0.0.1:5433/akili

# Separate database for tests.
TEST_DATABASE_URL=postgresql+asyncpg://akili:<url-encoded-password>@127.0.0.1:5433/akili_test

# Google Gemini runtime provider. These values are read by the backend only.
LLM_PROVIDER=google
LLM_MODEL=<gemini-model-id>
LLM_API_KEY=<google-api-key>

# Optional model settings. Defaults are shown.
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_OUTPUT_TOKENS=4096
# AGENT_HISTORY_MESSAGES=10

# Binance Spot REST credentials. Read-only credentials are recommended.
# These values are read by the backend only; the frontend never receives them.
BINANCE_API_KEY=<read-only-spot-api-key>
BINANCE_API_SECRET=<spot-api-secret>
BINANCE_USE_TESTNET=false
